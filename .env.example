# ==============================================================================
# [개발3팀] 정보보호공시 시스템(InfoSD) 환경 설정 템플릿 (.env.example)
# ==============================================================================
# 사용법: 이 파일을 복사하여 .env 로 이름을 변경한 후 사용하세요.
#   cp .env.example .env

# 1. 운영/개발 환경 구분
# IS_PROD=true  → 운영서버 모드 (MySQL 'infosd' 전용 DB 사용)
# IS_PROD=false → 개발서버 모드 (SQLite 'infosd.db' 사용)
IS_PROD=false

# 2. Flask 구동 포트
infosd_PORT=5003

# 3. 세션 비밀 키
infosd_SECRET_KEY=infosd-dev-secret-key-change-in-production

# 4. 데이터베이스 경로 및 URL
infosd_DB_PATH=infosd.db
INFOSD_DATABASE_URL=mysql://root:150606@127.0.0.1:3306/infosd
